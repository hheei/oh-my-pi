#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

require_bun() {
	if ! command -v bun >/dev/null 2>&1; then
		echo "error: Bun >= 1.3.14 is required: https://bun.sh/docs/installation" >&2
		exit 1
	fi
}

dependency_files() {
	for file in "$repo_root/package.json" "$repo_root"/packages/*/package.json "$repo_root/python/robomp/web/package.json" "$repo_root/bun.lock" "$repo_root/bunfig.toml" "$repo_root/.npmrc"; do
		[ -f "$file" ] && printf '%s\n' "$file"
	done
}

native_files() {
	for file in "$repo_root/Cargo.toml" "$repo_root/Cargo.lock" "$repo_root/rust-toolchain.toml" "$repo_root/.cargo/config.toml" "$repo_root/packages/natives/package.json"; do
		[ -f "$file" ] && printf '%s\n' "$file"
	done
	for crate in pi-ast pi-iso pi-natives pi-shell pi-voice pi-walker; do
		[ -f "$repo_root/crates/$crate/Cargo.toml" ] && printf '%s\n' "$repo_root/crates/$crate/Cargo.toml"
		find "$repo_root/crates/$crate/src" -type f -print 2>/dev/null
	done
	find "$repo_root/packages/natives/scripts" -type f -print 2>/dev/null
}

fingerprint() {
	LC_ALL=C sort | while IFS= read -r file; do
		cksum "$file"
	done | cksum | awk '{ print $1 ":" $2 }'
}

has_native_addon() {
	find "$repo_root/packages/natives/native" -maxdepth 1 -type f -name 'pi_natives*.node' -print -quit 2>/dev/null | grep -q .
}

read_state() {
	state_deps=
	state_native=
	if [ -f "$state_file" ]; then
		while IFS='=' read -r key value; do
			case "$key" in
				deps) state_deps=$value ;;
				native) state_native=$value ;;
			esac
		done < "$state_file"
	fi
}

write_state() {
	tmp_state="$state_file.tmp.$$"
	{
		printf 'deps=%s\n' "$deps_fingerprint"
		printf 'native=%s\n' "$native_fingerprint"
	} > "$tmp_state"
	mv "$tmp_state" "$state_file"
}

setup_repo() {
	if [ "$needs_install" = 1 ]; then
		echo "==> installing workspace dependencies"
		bun --cwd="$repo_root" install --frozen-lockfile
	fi

	if [ "$needs_native" = 1 ]; then
		echo "==> building native addon"
		CARGO_INCREMENTAL=1 bun --cwd="$repo_root" run build:native
	fi

	write_state
}

require_bun

state_file="$repo_root/node_modules/.omp-dev-state"
deps_fingerprint=$(dependency_files | fingerprint)
native_fingerprint=$(native_files | fingerprint)
read_state

needs_install=0
needs_native=0
[ -d "$repo_root/node_modules" ] || needs_install=1
[ -e "$repo_root/node_modules/@oh-my-pi/pi-coding-agent" ] || needs_install=1
[ -e "$repo_root/node_modules/@oh-my-pi/pi-natives" ] || needs_install=1
[ "$state_deps" = "$deps_fingerprint" ] || needs_install=1
has_native_addon || needs_native=1
[ "$state_native" = "$native_fingerprint" ] || needs_native=1

setup_repo
optimizer_package=$repo_root/packages/hepi/omp-optimizer
enhance_package=$repo_root/packages/hepi/omp-enhance

# Checkout hepi extensions shadow same-named globally installed copies.
# Keep management commands untouched; only inject for launch invocations.
require_local_hepi() {
	for pkg in "$optimizer_package" "$enhance_package"; do
		if [ ! -d "$pkg" ]; then
			echo "error: local extension not found: $pkg" >&2
			exit 1
		fi
	done
}

load_local_hepi=0
case "${1-}" in
	"") load_local_hepi=1 ;;
	launch)
		shift
		require_local_hepi
		set -- launch -e "$optimizer_package" -e "$enhance_package" "$@"
		;;
	acp|auth-broker|auth-gateway|agents|bench|browser-relay|cleanse|commit|completions|__complete|compress|config|dry-balance|gc|grep|gallery|git|grievances|images|if-bench|install|join|models|plugin|ps|say|share|setup|shell|read|render|ssh|stats|update|usage|tiny-models|token|ttsr|worktree|search)
		;;
	-h|--help|--version)
		;;
	-*) load_local_hepi=1 ;;
	@*) load_local_hepi=1 ;;
	*) load_local_hepi=1 ;;
esac

if [ "$load_local_hepi" = 1 ]; then
	require_local_hepi
	set -- -e "$optimizer_package" -e "$enhance_package" "$@"
fi
exec "$repo_root/packages/coding-agent/scripts/omp" "$@"
