#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repo_root"

require_bun() {
	if ! command -v bun >/dev/null 2>&1; then
		echo "error: Bun >= 1.3.14 is required: https://bun.sh/docs/installation" >&2
		exit 1
	fi
}

dependency_files() {
	for file in package.json packages/*/package.json python/robomp/web/package.json bun.lock bunfig.toml .npmrc; do
		[ -f "$file" ] && printf '%s\n' "$file"
	done
}

native_files() {
	for file in Cargo.toml Cargo.lock rust-toolchain.toml .cargo/config.toml packages/natives/package.json; do
		[ -f "$file" ] && printf '%s\n' "$file"
	done
	for crate in pi-ast pi-iso pi-natives pi-shell pi-voice pi-walker; do
		[ -f "crates/$crate/Cargo.toml" ] && printf '%s\n' "crates/$crate/Cargo.toml"
		find "crates/$crate/src" -type f -print 2>/dev/null
	done
	find packages/natives/scripts -type f -print 2>/dev/null
}

fingerprint() {
	LC_ALL=C sort | while IFS= read -r file; do
		cksum "$file"
	done | cksum | awk '{ print $1 ":" $2 }'
}

has_native_addon() {
	find packages/natives/native -maxdepth 1 -type f -name 'pi_natives*.node' -print -quit 2>/dev/null | grep -q .
}

read_state() {
	state_deps=
	state_native=
	if [ -f "$state_file" ]; then
		while IFS='=' read -r key value; do
			case "$key" in
				deps) state_deps=$value ;;
				native) state_native=$value ;;
			esac
		done < "$state_file"
	fi
}

write_state() {
	tmp_state="$state_file.tmp.$$"
	{
		printf 'deps=%s\n' "$deps_fingerprint"
		printf 'native=%s\n' "$native_fingerprint"
	} > "$tmp_state"
	mv "$tmp_state" "$state_file"
}

setup_repo() {
	if [ "$needs_install" = 1 ]; then
		echo "==> installing workspace dependencies"
		bun install --frozen-lockfile
	fi

	if [ "$needs_native" = 1 ]; then
		echo "==> building native addon"
		CARGO_INCREMENTAL=1 bun run build:native
	fi

	write_state
}

require_bun

state_file=node_modules/.omp-dev-state
deps_fingerprint=$(dependency_files | fingerprint)
native_fingerprint=$(native_files | fingerprint)
read_state

needs_install=0
needs_native=0
[ -d node_modules ] || needs_install=1
[ -e node_modules/@oh-my-pi/pi-coding-agent ] || needs_install=1
[ -e node_modules/@oh-my-pi/pi-natives ] || needs_install=1
[ "$state_deps" = "$deps_fingerprint" ] || needs_install=1
has_native_addon || needs_native=1
[ "$state_native" = "$native_fingerprint" ] || needs_native=1

setup_repo

exec bun --cwd=packages/coding-agent src/cli.ts "$@"
